PORT=3000
DATABASE_URL="postgresql://basketeasy:basketeasy@localhost:5432/basketeasy"
JWT_ACCESS_SECRET="change-me-to-a-long-random-secret-value-in-production"
# Origin of the frontend. Every verification and password-reset link, and
# every deep link in a notification e-mail or push payload, is built from it.
FRONTEND_URL="http://localhost:5173"
# Leave BREVO_API_KEY empty to have MailModule bind its logging client: no
# e-mail leaves the process, and each one is written to the server log
# instead — the intended way to follow a verification or reset link locally.
BREVO_API_KEY=
