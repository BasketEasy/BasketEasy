# --- API ---
PORT=3000
NODE_ENV=development
# Controls the `Secure` flag on the refresh-token cookie, independent of
# NODE_ENV. Defaults to secure (true) when unset; only docker-compose.dev.yml
# sets this to 'false' for plain-HTTP local dev.
COOKIE_SECURE=true
# Origin of the deployed frontend, used for CORS and to validate the
# Sec-Fetch-Site/Origin of auth requests. Must be an exact origin (scheme +
# host, no trailing slash) — e.g. https://kluvo.net in prod, where frontend
# (Cloudflare Workers) and API (Scaleway, behind api.kluvo.net) are on
# different subdomains of the same registrable domain.
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://basketeasy:basketeasy@postgres:5432/basketeasy
# Prisma's `directUrl` — an unpooled connection used for migrations. Neon
# (prod) needs this distinct from DATABASE_URL because prod DATABASE_URL is
# pooled; the local postgres container has no pooling, so both docker-compose
# files just point this at the same connection as DATABASE_URL.
NEON_DIRECT_URL=postgresql://basketeasy:basketeasy@postgres:5432/basketeasy
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-value-in-production
JWT_REFRESH_SECRET=change-me-too
# Optional — where FfbbPageScrapeProvider fetches team pages from. Defaults
# to https://competitions.ffbb.com when unset; only worth overriding for
# testing against a mock/staging FFBB endpoint.
# FFBB_BASE_URL=https://competitions.ffbb.com
# Cloudflare R2 (scoresheet photo storage) — bucket must be created with the
# EU jurisdictional restriction (RGPD: scoresheet photos are minors' data).
# Unlike JWT_ACCESS_SECRET, the server still boots without these; only a
# scoresheet upload attempt fails until they're set.
R2_ACCOUNT_ID=change-me
R2_BUCKET=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
# Scoresheet OCR (Gemini vision, free tier at aistudio.google.com). Same
# "server still boots without it" behavior as the R2_* vars above — only an
# actual OCR job fails until this is set.
GEMINI_API_KEY=change-me
# Brevo transactional e-mail (verification links, password resets,
# notification e-mails). Same "server still boots without it" behavior as the
# R2_*/GEMINI vars above, with one deliberate extra: when BREVO_API_KEY is
# empty, MailModule binds a logging client instead, so every e-mail is
# written to the server log rather than sent. That is what makes the
# verification and password-reset flows testable in local dev with no Brevo
# account at all — copy the link out of the log and follow it.
BREVO_API_KEY=
# The visible sender. Every message is transactional and machine-generated,
# so this is a no-reply address — but a reader will reply anyway, and a reply
# that bounces is worse than none, so MAIL_REPLY_TO_EMAIL points at a
# monitored mailbox instead. Both must be on a domain verified in Brevo.
MAIL_FROM_EMAIL=no-reply@kluvo.net
MAIL_REPLY_TO_EMAIL=contact@kluvo.net
MAIL_FROM_NAME=Kluvo
# Web Push (browser notifications). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Leave empty to disable push entirely — the API then reports a null public
# key and the frontend hides its "activer les notifications" control rather
# than offering a subscription nothing could ever deliver to. VAPID_SUBJECT
# must be a mailto: or https: URL identifying the sender; push services
# reject the request without one.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@kluvo.net
# Nightly data-retention sweep (RetentionModule): erases accounts inactive for
# 12 months, prunes security logs past 12 months, and deletes parental-consent
# proofs whose five years are up. Set to 'false' to leave it unscheduled — the
# API still boots and serves everything else either way, same policy as the
# other integration credentials above.
RETENTION_SWEEP_ENABLED=true
# Observation mode: every step reports what it *would* delete and still writes
# a RetentionRun row for the compliance record, but nothing is deleted. Run a
# deployment's first cycle like this before letting the policy erase live
# accounts.
RETENTION_SWEEP_DRY_RUN=false
# Platform back-office (GDPR access/erasure handling + retention sweep
# oversight). Signs the short-lived step-up token that every /admin/* route
# requires *in addition to* a normal session — deliberately NOT
# JWT_ACCESS_SECRET, so a leaked access-token secret cannot also mint
# back-office credentials.
#
# Same "server still boots without it" behavior as the R2_*/GEMINI/VAPID vars
# above, with the same deliberate consequence as VAPID: leave it empty and the
# back-office does not exist for this deployment — every /admin/* route
# answers 503 and no step-up token can be minted at all. That is the right
# default for the one surface where a compromised credential would expose
# every club's roster at once.
#
# Must be at least 32 characters, the same floor JWT_ACCESS_SECRET is held to
# at boot — a shorter one is treated as if unset (back-office off) rather than
# arming it behind a guessable key. Generate one with:
#   openssl rand -base64 48
#
# Grants themselves are provisioned out-of-band, never through the product:
#   cd server && pnpm exec ts-node scripts/platform-admin.ts grant <email> DATA_OFFICER
PLATFORM_JWT_SECRET=
# How many reverse proxies sit between the internet and this API. Drives
# Express's `trust proxy`, which is what makes `req.ip` — and therefore every
# AuditLog row and the back-office's per-admin IP allowlist — the visitor's
# address rather than the proxy's or the Docker bridge's.
#
# COUNT THE HOPS. This is not a boolean: a proxy appends the peer it saw to
# the right of X-Forwarded-For, so the value is read right-to-left, skipping
# that many entries. Set it too high and a client can pad the header to
# choose their own apparent address; set it too low and you record the
# proxy's. One Caddy/nginx in front of the container = 1. Cloudflare in front
# of that nginx = 2.
#
#   unset / false / 0  → trust nothing (correct with no proxy at all)
#   1, 2, ...          → that many trusted hops
#   a CIDR list        → e.g. '172.18.0.0/16' or 'loopback, 10.0.0.0/8'
#
# 'true' is accepted and read as 1 hop — Express's literal "trust every hop"
# is the spoofable setting and is deliberately not honoured.
#
# Production today is 1: a single Caddy container terminates TLS for
# api.kluvo.net and reverse-proxies to the server container, with no CDN in
# front (api.kluvo.net is a plain A record, DNS-only). One hop is not merely
# correct there but unspoofable, because Caddy appends the true peer to the
# right of the header and Express reads it right-to-left. Put a CDN in front
# and this becomes 2 — at which point prefer the CIDR-list form, since a hop
# count can be defeated by connecting to the origin directly.
TRUSTED_PROXY=false

# --- Postgres (docker-compose) ---
POSTGRES_USER=basketeasy
POSTGRES_PASSWORD=basketeasy
POSTGRES_DB=basketeasy

# --- Web ---
# Relative "/api" only works when frontend and API share an origin (Vite
# proxy in dev, nginx in the Docker image). For a split deployment (Cloudflare
# Workers frontend at kluvo.net, Scaleway API behind api.kluvo.net), this must
# be the API's absolute origin, e.g. https://api.kluvo.net/api.
VITE_API_BASE_URL=/api
