# --- API ---
PORT=3000
NODE_ENV=development
# Controls the `Secure` flag on the refresh-token cookie, independent of
# NODE_ENV. Defaults to secure (true) when unset; only docker-compose.dev.yml
# sets this to 'false' for plain-HTTP local dev.
COOKIE_SECURE=true
# Origin of the deployed frontend, used for CORS and to validate the
# Sec-Fetch-Site/Origin of auth requests. Must be an exact origin (scheme +
# host, no trailing slash) — e.g. https://basketeasy.pages.dev in prod, where
# frontend and API are on different sites (pages.dev vs onrender.com).
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://basketeasy:basketeasy@postgres:5432/basketeasy
# Prisma's `directUrl` — an unpooled connection used for migrations. Neon
# (prod) needs this distinct from DATABASE_URL because prod DATABASE_URL is
# pooled; the local postgres container has no pooling, so both docker-compose
# files just point this at the same connection as DATABASE_URL.
NEON_DIRECT_URL=postgresql://basketeasy:basketeasy@postgres:5432/basketeasy
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-value-in-production
JWT_REFRESH_SECRET=change-me-too
# Optional — where FfbbPageScrapeProvider fetches team pages from. Defaults
# to https://competitions.ffbb.com when unset; only worth overriding for
# testing against a mock/staging FFBB endpoint.
# FFBB_BASE_URL=https://competitions.ffbb.com
# Cloudflare R2 (scoresheet photo storage) — bucket must be created with the
# EU jurisdictional restriction (RGPD: scoresheet photos are minors' data).
# Unlike JWT_ACCESS_SECRET, the server still boots without these; only a
# scoresheet upload attempt fails until they're set.
R2_ACCOUNT_ID=change-me
R2_BUCKET=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
# Scoresheet OCR (Gemini vision, free tier at aistudio.google.com). Same
# "server still boots without it" behavior as the R2_* vars above — only an
# actual OCR job fails until this is set.
GEMINI_API_KEY=change-me
# Brevo transactional e-mail (verification links, password resets,
# notification e-mails). Same "server still boots without it" behavior as the
# R2_*/GEMINI vars above, with one deliberate extra: when BREVO_API_KEY is
# empty, MailModule binds a logging client instead, so every e-mail is
# written to the server log rather than sent. That is what makes the
# verification and password-reset flows testable in local dev with no Brevo
# account at all — copy the link out of the log and follow it.
# MAIL_FROM_EMAIL must be an address on a domain verified in Brevo, or every
# send is rejected with a 400.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@kluvo.fr
MAIL_FROM_NAME=Kluvo
# Web Push (browser notifications). Generate a pair once with:
#   npx web-push generate-vapid-keys
# Leave empty to disable push entirely — the API then reports a null public
# key and the frontend hides its "activer les notifications" control rather
# than offering a subscription nothing could ever deliver to. VAPID_SUBJECT
# must be a mailto: or https: URL identifying the sender; push services
# reject the request without one.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@kluvo.fr

# --- Postgres (docker-compose) ---
POSTGRES_USER=basketeasy
POSTGRES_PASSWORD=basketeasy
POSTGRES_DB=basketeasy

# --- Web ---
# Relative "/api" only works when frontend and API share an origin (Vite
# proxy in dev, nginx in the Docker image). For a split deployment (e.g.
# Cloudflare Pages frontend + Render API on different hosts), this must be
# the API's absolute origin, e.g. https://basketeasy.onrender.com/api.
VITE_API_BASE_URL=/api
