# Kluvo — configuration de l'agent Alloy (à copier en /opt/kluvo/monitoring/.env.monitoring).
#
# Les deux URL se relèvent dans la console Scaleway : Cockpit → Data sources
# (ne pas les deviner, elles dépendent de la région du projet). Le token se
# crée dans Cockpit → Tokens, avec la permission "push" sur les métriques
# (et sur les logs seulement si l'overlay logs est activé).

COCKPIT_METRICS_PUSH_URL=https://<votre-endpoint>.cockpit.<region>.scw.cloud/api/v1/push
COCKPIT_LOGS_PUSH_URL=https://<votre-endpoint>.cockpit.<region>.scw.cloud/loki/api/v1/push
COCKPIT_PUSH_TOKEN=
