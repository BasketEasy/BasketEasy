{
  "name": "@basketeasy/app",
  "version": "0.0.0",
  "private": true,
  "description": "BasketEasy frontend (React + Vite)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
